<http://vocab.nerc.ac.uk/collection/S06/current/S0600083/> a iop:Property ; rdfs:label "practical salinity" ; schema:name "practical salinity" ; schema:url <http://vocab.nerc.ac.uk/collection/S06/current/S0600083/> .
<http://vocab.nerc.ac.uk/collection/P14/current/GVAR0653/> a iop:Property ; rdfs:label "potential temperature" ; schema:name "potential temperature" ; schema:url <http://vocab.nerc.ac.uk/collection/P14/current/GVAR0653/> .
<http://qudt.org/vocab/quantitykind/ThermodynamicTemperature> a iop:Property ; rdfs:label "thermodynamic temperature" ; schema:name "thermodynamic temperature" ; schema:url <http://qudt.org/vocab/quantitykind/ThermodynamicTemperature> .
<https://www.wikidata.org/entity/Q139568528> a iop:Property ; rdfs:label "number density per unit mass" ; schema:name "number density per unit mass" ; schema:url <https://www.wikidata.org/entity/Q139568528> .
<https://www.wikidata.org/entity/Q5955496> a iop:Entity ; rdfs:label "uranium-236" ; schema:name "uranium-236" ; schema:url <https://www.wikidata.org/entity/Q5955496> .

# constraint, following the pattern in SSW.ttl / SST.ttl
<https://w3id.org/ro-id/NORESM-RO#node-c-surface> a iop:Constraint ; rdfs:label "part: surface" ; schema:name "part: surface" ; iop:constrains <http://vocabs.lter-europe.net/EnvThes/22225> .

