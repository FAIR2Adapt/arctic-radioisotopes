    {
      "@id": "./",
      "@type": "Dataset",
      "name": "NorESM2 Arctic radioisotopes — ocean temperature, salinity and U-236 tracers 2010-2018",
      "description": "Monthly mean ocean fields from NorESM2 (BLOM-CICE5) forced by JRA-55, covering 2010-2018 on 53 isopycnal (potential density) layers of the native BLOM tripolar grid. Includes surface and three-dimensional temperature and salinity, and three uranium-236 tracers that separate global fallout from the Sellafield and La Hague reprocessing discharges, enabling the Arctic contribution of each source to be traced independently. Converted to Analysis-Ready Cloud-Optimized Zarr with CF-1.8 and ACDD-1.3 metadata.",
      "identifier": "JRAOC20TRNRPv2_2010-2018",
      "license": { "@id": "https://creativecommons.org/licenses/by/4.0/" },
      "publisher": { "@id": "#project-fair2adapt" },
      "creator": [{ "@id": "#yanchun-he" }, { "@id": "#anne-fouilloux" }],
      "citedcat:dataCollector": { "@id": "#yanchun-he" },
      "datePublished": "2026-08-06",
      "temporalCoverage": "2010-01-01/2018-12-31",
      "spatialCoverage": { "@id": "#place-global-ocean" },
      "isRelatedTo": { "@id": "#mvp-arctic-radioisotopes" },
      "cca:hasCampaign": { "@id": "#campaign-nks-b-anthropic" },
      "variableMeasured": [
        { "@id": "#var-sst" },
        { "@id": "#var-sss" },
        { "@id": "#var-temp" },
        { "@id": "#var-saln" },
        { "@id": "#var-U236GF" },
        { "@id": "#var-U236SF" },
        { "@id": "#var-U236LH" }
      ],
      "hasPart": [
        { "@id": "https://fair2adapt.duckdns.org/afouilloux-noresm/JRAOC20TRNRPv2_all_2010-2018.zarr" },
        { "@id": "https://fair2adapt.duckdns.org/afouilloux-noresm/JRAOC20TRNRPv2_all_2010-2018_hp.zarr" }
      ],
      "dct:source": "simulations",
      "dct:type": "produced",
      "cca:dataNature": "modeled",
      "cca:stability": "fixed",
      "cca:acquisitionMethod": "Numerical ocean-ice simulation (NorESM2 BLOM-CICE5) forced by JRA-55 atmospheric reanalysis, with passive U-236 tracers released from distinct sources.",
      "cca:acquisitionFrequency": "P1M",
      "cca:surveyAutomation": "automatic",
      "cca:validationApproach": "Converted fields verified bit-identical to the source netCDF; standard names validated against the CF standard name table v94.",
      "cca:datasetNumber": 2,
      "dct:conformsTo": [
        { "@id": "https://cfconventions.org/cf-conventions/v1.8/cf-conventions.html" },
        { "@id": "https://wiki.esipfed.org/Attribute_Convention_for_Data_Discovery_1-3" }
      ],
      "dpv:hasSensitivityLevel": "non-sensitive",
      "dct:format": "application/vnd.zarr",
      "dcat:byteSize": 21500000000,
      "dct:provenance": { "@id": "https://github.com/FAIR2Adapt/arctic-radioisotopes" },
      "citation": "He, Y., Hamre, T., Lin, M., Qiao, J., Nielsen, S. P., Lin, G., Samuelsen, A., Jeansson, E. (2026). NorESM2 ocean reanalysis with U-236 tracers 2010-2018. Nansen Environmental and Remote Sensing Center.",
      "acknowledgement": "Data were generated in the NKS-B ANTHROPIC project (contract AFT/B(23)4), formatted and made FAIR under FAIR2Adapt (EU grant no. 101188256)."
    },

    {
      "@id": "https://fair2adapt.duckdns.org/afouilloux-noresm/JRAOC20TRNRPv2_all_2010-2018.zarr",
      "@type": "Dataset",
      "name": "JRAOC20TRNRPv2_all_2010-2018.zarr",
      "description": "All seven variables on the native BLOM tripolar curvilinear grid (385x360) with 2-D longitude/latitude coordinates. Chunked one rendered map per chunk (~554 KB), Zstd compressed. This is the store that supports the nearside-perspective projection in the FAIR2Adapt dashboard.",
      "encodingFormat": "application/vnd.zarr",
      "contentSize": 6100000000,
      "geodcat:spatialResolutionAsText": "BLOM tripolar grid, ~111 km at the equator, ~38 km in the Arctic",
      "conformsTo": { "@id": "https://cfconventions.org/cf-conventions/v1.8/cf-conventions.html" },
      "schema:potentialAction": { "@id": "#view-tripolar" }
    },
    {
      "@id": "https://fair2adapt.duckdns.org/afouilloux-noresm/JRAOC20TRNRPv2_all_2010-2018_hp.zarr",
      "@type": "Dataset",
      "name": "JRAOC20TRNRPv2_all_2010-2018_hp.zarr",
      "description": "The same seven variables regridded to a HEALPix discrete global grid, refinement level 8 (nested indexing, WGS84, ~25 km), 265,248 cells. Level 8 was chosen so that the ~38 km Arctic resolution of the source grid is preserved. Nearest-neighbour resampling, so no values absent from the source are introduced.",
      "encodingFormat": "application/vnd.zarr",
      "contentSize": 15000000000,
      "geodcat:spatialResolutionAsText": "HEALPix refinement level 8 (nside 256), ~25 km, uniform",
      "conformsTo": { "@id": "https://cfconventions.org/cf-conventions/v1.8/cf-conventions.html" }
    },
    {
      "@id": "#view-tripolar",
      "@type": "ViewAction",
      "name": "View in the FAIR2Adapt dashboard",
      "target": "https://f2a.plan4all.eu/#https://fair2adapt.duckdns.org/afouilloux-noresm/JRAOC20TRNRPv2_all_2010-2018.zarr::varname=U236SF::dimIndices_time=0::dimIndices_sigma=25::projection=nearside_perspective::projectionCenterLat=90::projectionCenterLon=0"
    },

    {
      "@id": "#mvp-arctic-radioisotopes",
      "@type": "Product",
      "name": "Traceable Arctic radioisotope transport from European reprocessing discharges",
      "description": "A cloud-optimised, FAIR ocean dataset that lets stakeholders attribute Arctic U-236 contamination to specific sources — global fallout, Sellafield, or La Hague — and inspect it interactively in an Arctic-centred projection.",
      "variableMeasured": [
        { "@id": "#var-U236GF" },
        { "@id": "#var-U236SF" },
        { "@id": "#var-U236LH" }
      ],
      "schema:depth": "53 isopycnal layers, potential density 27.22-37.80 kg m-3",
      "temporalCoverage": "2010-01-01/2018-12-31",
      "spatialCoverage": { "@id": "#place-global-ocean" },
      "cca:scenarioId": "JRAOC20TRNRPv2",
      "geodcat:spatialResolutionAsText": "~38 km in the Arctic on the native grid; HEALPix level 8 (~25 km) in the DGGS variant",
      "license": { "@id": "https://creativecommons.org/licenses/by/4.0/" },
      "dct:provenance": { "@id": "https://github.com/FAIR2Adapt/arctic-radioisotopes" }
    },

